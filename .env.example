# Copy to .env and set your own TMDB API key (https://www.themoviedb.org/settings/api).
# Never commit .env.
#
# WARNING: Create React App inlines every REACT_APP_* variable into the JavaScript bundle at build
# time, so this key is visible to anyone who opens the deployed site. Use a key you can rotate,
# and see the README for how to keep it off the client.
REACT_APP_TMDB_API_KEY=your-tmdb-api-key
